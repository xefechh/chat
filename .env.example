PORT=3000
REDIS_URL=redis://:replace-with-redis-password@localhost:6379
REDIS_PASSWORD=replace-with-redis-password
FIRESTORE_PROJECT_ID=your-gcp-project-id
SESSION_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Required when NODE_ENV=production
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
# Use either GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/key.json
# or Application Default Credentials in the runtime environment.
GOOGLE_APPLICATION_CREDENTIALS=
